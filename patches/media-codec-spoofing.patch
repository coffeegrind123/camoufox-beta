+  // Camoufox: with media:spoof_codecs, canPlayType()/isTypeSupported() answer
+  // for the claimed OS rather than the host's decoders (media-codec-spoofing),
+  // so decodingInfo() must agree with them instead of asking the host: a Linux
+  // container claiming Windows otherwise reports H.264, HEVC and AAC
+  // unsupported, and VP9 software-only. Stock 152.0.4 on Windows reports every
+  // supported codec smooth, audio power-efficient, and video power-efficient
+  // where the GPU decodes it (media:hwCodecs) or the frame is small, which is
+  // the same rule CreateVideoDecodingInfo applies.
+  if (MaskConfig::GetBool("media:spoof_codecs").value_or(false)) {
+    const std::vector<std::string> hwCodecs =
+        MaskConfig::GetStringList("media:hwCodecs");
+    bool powerEfficient = true;
+    for (const auto& config : tracks) {
+      if (!config->IsVideo()) {
+        continue;
+      }
+      if (shouldResistFingerprinting) {
+        powerEfficient = false;
+        continue;
+      }
+      const auto& image = config->GetAsVideoInfo()->mImage;
+      const CheckedInt<uint32_t> pixels = CheckedInt<uint32_t>(image.width) *
+                                          CheckedInt<uint32_t>(image.height);
+      const bool lowResolution =
+          pixels.isValid() && pixels.value() <= kLowResolutionPixelCount;
+      const bool hardware =
+          std::find(hwCodecs.begin(), hwCodecs.end(),
+                    std::string(config->mMimeType.get())) != hwCodecs.end();
+      powerEfficient &= hardware || lowResolution;
+    }
+    MediaCapabilitiesDecodingInfo info;
+    info.mSupported = true;
+    info.mSmooth = true;
+    info.mPowerEfficient = powerEfficient;
+    LOG("spoofed {} -> {}", aConfiguration, info);
+    aPromise->MaybeResolve(std::move(info));
+    return;
+  }
+
