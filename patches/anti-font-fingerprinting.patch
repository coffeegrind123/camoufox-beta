+#ifndef mozilla_dom_RoverfoxStorageManager_h
+#define mozilla_dom_RoverfoxStorageManager_h
+
+#include "nsString.h"
+#include "nsTHashMap.h"
+#include "nsTHashSet.h"
+#include "nsHashKeys.h"
+#include "mozilla/Mutex.h"
+
+namespace mozilla {
+namespace dom {
+
+// Cross-process key-value storage using Firefox Preferences + local cache.
+// Write-through: values stored locally (immediate reads) and sent to parent
+// process via IPDL (cross-process sync via Preferences API).
+// Keys prefixed with "roverfox.s." to avoid conflicts.
+class RoverfoxStorageManager {
+ public:
+  static void PutUint(const nsAString& key, uint32_t value);
+  static bool GetUint(const nsAString& key, uint32_t& outValue);
+  static void PutBool(const nsAString& key, bool value);
+  static bool GetBool(const nsAString& key, bool& outValue);
+  static void PutString(const nsAString& key, const nsAString& value);
+  static bool GetString(const nsAString& key, nsAString& outValue);
+  static void Remove(const nsAString& key);
+  // The same reads for the value stored under aPrefix followed by aId
+  // ("nav_hwc_", 3 -> "nav_hwc_3"), for getters a page can call in a loop.
+  // Each thread memoizes the answer until any write in this process, so a
+  // repeat read builds no key and takes no lock. aPrefix must be a string
+  // literal: its address is part of the memo key.
+  static bool GetUint(const char* aPrefix, uint32_t aId, uint32_t& outValue);
+  static bool GetBool(const char* aPrefix, uint32_t aId, bool& outValue);
+  static bool GetString(const char* aPrefix, uint32_t aId, nsAString& outValue);
+  // A put reached this process's prefs: copy it into the local cache (main
+  // thread only), which is all a worker thread reads.
+  static void MirrorPref(const nsACString& aPrefName);
+
+ private:
+  static nsCString MakePrefName(const nsAString& key);
+  static void SetPrefValue(const nsCString& prefName, const nsCString& value);
+  static void SyncToParent(const nsCString& prefName, const nsCString& value);
+  static void ReadValue(const nsCString& prefName, nsACString& outValue);
+  static void EnsureMirror();
+  struct MemoSlot;
+  static MemoSlot ReadMemoized(const char* aPrefix, uint32_t aId);
+  static void BumpGeneration();
+  static nsTHashMap<nsCStringHashKey, nsCString>& GetLocalCache();
+  static mozilla::Mutex& GetLocalCacheMutex();
+};
+
+}  // namespace dom
+}  // namespace mozilla
+
+#endif  // mozilla_dom_RoverfoxStorageManager_h
