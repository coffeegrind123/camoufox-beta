+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+// Windows' shortcut key tables, built into the GTK build for identities that
+// claim Windows (config "input:windowsKeyboard"). ShortcutKeyDefinitions.cpp
+// is compiled a second time with the Windows platform macros, so the tables
+// are Windows' own rather than a copy that could drift from them.
+
+#include "ShortcutKeys.h"
+
+#pragma push_macro("MOZ_WIDGET_GTK")
+#undef MOZ_WIDGET_GTK
+#define XP_WIN 1
+#define sInputHandlers sInputHandlersWin
+#define sTextAreaHandlers sTextAreaHandlersWin
+#define sBrowserHandlers sBrowserHandlersWin
+#define sEditorHandlers sEditorHandlersWin
+
+#include "ShortcutKeyDefinitions.cpp"
+
+#undef sInputHandlers
+#undef sTextAreaHandlers
+#undef sBrowserHandlers
+#undef sEditorHandlers
+#undef XP_WIN
+#pragma pop_macro("MOZ_WIDGET_GTK")
