+  static const bool sWindows =
+      MaskConfig::GetBool("input:windowsKeyboard").value_or(false);
+#  define CAMOU_KEYS(aName) (sWindows ? &aName##Win[0] : &aName[0])
+#else
+#  define CAMOU_KEYS(aName) (&aName[0])
+#endif
   switch (aType) {
     case HandlerType::eBrowser:
-      keyData = &sBrowserHandlers[0];
+      keyData = CAMOU_KEYS(sBrowserHandlers);
       cache = &mBrowserHandlers;
       break;
     case HandlerType::eEditor:
-      keyData = &sEditorHandlers[0];
+      keyData = CAMOU_KEYS(sEditorHandlers);
       cache = &mEditorHandlers;
       break;
     case HandlerType::eInput:
-      keyData = &sInputHandlers[0];
+      keyData = CAMOU_KEYS(sInputHandlers);
       cache = &mInputHandlers;
       break;
     case HandlerType::eTextArea:
-      keyData = &sTextAreaHandlers[0];
+      keyData = CAMOU_KEYS(sTextAreaHandlers);
       cache = &mTextAreaHandlers;
       break;
     default:
       MOZ_ASSERT(false, "Unknown handler type requested.");
   }
+#undef CAMOU_KEYS
 
   if (*cache) {
     return *cache;
